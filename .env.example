# ===================================
# QAOps Orchestrator Configuration
# ===================================
# IMPORTANT: Never commit actual credentials to version control.
# Copy this file to .env and fill in YOUR OWN values locally.
# .env is in .gitignore and will NOT be committed.

# ===================================
# LLM Configuration (Required)
# ===================================
# Get your API key from: https://ai.google.dev/tutorials/python_quickstart
GOOGLE_API_KEY=

# ─── Google Gemini LLM ────────────────────────────────────────────────────
LLM_MODEL=gemini/gemini-2.5-flash-lite

# ===================================
# Okahu Observability (Optional)
# ===================================
# Get your API key from: https://app.okahu.ai/settings/api-keys
OKAHU_API_KEY=

# Monocle exporter type: file, okahu, s3
MONOCLE_EXPORTER=file
# Output directory for file exporter
MONOCLE_OUTPUT_DIR=./traces

# ===================================
# AWS AgentCore (Optional)
# ===================================
AGENTCORE_RUNTIME_ID=
AGENTCORE_GATEWAY_ID=
AWS_REGION=us-east-1

# ===================================
# CI/CD Integration (Optional but recommended)
# ===================================
# Jenkins instance URL
JENKINS_URL=

# Jenkins username (service account recommended)
JENKINS_USER=

# Jenkins API token: https://your-jenkins/user/USERNAME/configure → API Token
JENKINS_TOKEN=

# ─── Jenkins (optional — leave blank to use GitHub Actions demo mode) ─────
# Required for GitHub Actions log fetching and GitHub Issues creation.
# Works with public repos at reduced rate-limits even without a token.
GITHUB_TOKEN=
GITHUB_REPO=owner/repo

# ===================================
# Issue Tracking - JIRA (Optional but recommended)
# ===================================
# JIRA instance URL
JIRA_URL=

# JIRA user email
JIRA_USER=

# JIRA API token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_TOKEN=

# JIRA project key (e.g., "QA", "DEVOPS")
JIRA_PROJECT=QA

# ===================================
# Observability - Grafana (Optional)
# ===================================
# Grafana instance URL
GRAFANA_URL=

# Grafana API token for metrics retrieval
GRAFANA_TOKEN=

# ===================================
# Logging Configuration
# ===================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Optional: Log file path (if empty, logs to console)
LOG_FILE=

# ===================================
# Optional: Google Cloud Platform (for Vertex AI)
# ===================================
# GCP Project ID for Vertex AI deployment
VERTEX_AI_PROJECT_ID=
# GCP region for Vertex AI
VERTEX_AI_REGION=us-central1

# ===================================
# Memory Configuration
# ===================================
# Path to memory bank file (stores recurring issue patterns)
MEMORY_BANK_PATH=./memory_bank.json
# Maximum memory entries to keep (auto-cleanup of old patterns)
MAX_MEMORY_ENTRIES=1000